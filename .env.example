# Environment Configuration for Turium AI Knowledge Inbox

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Database Path (defaults to knowledge_inbox.db)
DATABASE_PATH=knowledge_inbox.db

# AI Provider Configuration
# Supported providers: "auto", "openai", "gemini", "local"
# "auto" detects available keys (OpenAI -> Gemini -> Local Fallback)
AI_PROVIDER=auto

# OpenAI Configuration (Optional if using Gemini or Local Fallback)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Google Gemini Configuration (Optional if using OpenAI or Local Fallback)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval Configuration
DEFAULT_TOP_K=4
MIN_SIMILARITY_SCORE=0.1
